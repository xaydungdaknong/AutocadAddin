<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AutoCAD 2023 (R24.2) chạy trên .NET Framework 4.8 -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>DwgToDxf</AssemblyName>
    <RootNamespace>DwgToDxf</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Product>AutocadAddin: DWG2DXF and frame printing for AutoCAD 2023</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- AcCoreMgd / AcDbMgd / AcMgd. ExcludeAssets=runtime: không copy DLL của AutoCAD ra thư mục bin (Copy Local = false). -->
    <PackageReference Include="AutoCAD.NET" Version="24.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
